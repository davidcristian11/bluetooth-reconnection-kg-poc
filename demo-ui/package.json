{
  "name": "bluetooth-reconnection-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "data": "node scripts/export-data.mjs",
    "predev": "node scripts/export-data.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/export-data.mjs && tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write src scripts *.json *.js *.ts *.yaml *.md index.html",
    "test": "node --test scripts/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.5",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "csv-parse": "^6.1.0",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "yaml": "^2.8.1"
  }
}
